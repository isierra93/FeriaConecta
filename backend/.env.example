# =============================================================================
# FeriaConecta - Variables de entorno del backend
# Copiar este archivo a `.env` (en esta misma carpeta) y completar los valores.
# `.env` NUNCA se commitea. Estos valores son solo de ejemplo.
# Detalle de cada variable: ver backend/README.md
# =============================================================================

# Perfil de Spring: dev (H2 en memoria) o prod (MySQL)
SPRING_PROFILES_ACTIVE=dev

# --- Base de datos (solo se usa con el perfil prod) ---
DB_URL=jdbc:mysql://localhost:3306/feriaconecta
DB_USERNAME=feriaconecta
DB_PASSWORD=cambiar-me

# --- JWT ---
# Minimo 256 bits para HS256. Generar con: openssl rand -base64 32
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-bytes
# Vigencia del token en minutos
JWT_EXPIRATION_MINUTES=60

# --- Mercado Pago (usar SIEMPRE credenciales de prueba) ---
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_WEBHOOK_SECRET=cambiar-me

# --- URLs ---
# URL publica del backend, incluyendo el context-path
APP_BACKEND_URL=http://localhost:8080/api/v1
# URL base del frontend
APP_FRONTEND_URL=http://localhost:5173

# --- CORS ---
# Origenes permitidos, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Reglas de negocio ---
# Horas para pagar una postulacion aprobada antes de pasar a VENCIDA
PAGO_PLAZO_HORAS=72
